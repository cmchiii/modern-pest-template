{
  "title": "Contact",
  "permalink": "https://clearline-pest-template.vercel.app/contact",
  "order": 70,
  "draft": false,
  "seo": {
    "title": "Book a Free Pest Inspection",
    "description": "Book a free pest inspection with Clearline Pest Solutions. About 45 minutes, a written plan and a fixed price, no contract. Serving Phoenix, Scottsdale, Chandler and Mesa.",
    "noindex": false
  },
  "sections": [
    {
      "type": "hero",
      "layout": "split",
      "background": {
        "kind": "image",
        "image": {
          "source": "upload",
          "src": "/media/images/cockroach.avif",
          "alt": "American cockroach specimen on white"
        }
      },
      "eyebrow": "Free, about 45 minutes",
      "heading": "Book a free inspection.",
      "body": "A licensed technician walks the property inside and out, maps where pests are getting in, and leaves a written plan with a fixed price. No cost, and no contract.",
      "mediaNote": "American cockroach — last seen under the sink",
      "ctas": [
        {
          "label": "Call the office",
          "href": "tel:+15550147378",
          "style": "primary",
          "newTab": false
        }
      ],
      "badges": ["Free inspection", "Fixed price, valid 30 days", "No contract"],
      "headingLevel": "h1",
      "surface": "light",
      "spacing": "md",
      "width": "wide"
    },
    {
      "type": "form_block",
      "headingLevel": "h2",
      "eyebrow": "Two minutes",
      "heading": "Request a call.",
      "intro": "Tell us what you are seeing and we will call to arrange a time that suits you.",
      "endpoint": "https://formspree.io/f/REPLACE_WITH_YOUR_ID",
      "submitLabel": "Request a call",
      "fields": [
        {
          "kind": "text",
          "name": "first_name",
          "label": "First name",
          "required": true,
          "width": "half",
          "autocomplete": "given-name"
        },
        {
          "kind": "text",
          "name": "last_name",
          "label": "Last name",
          "required": true,
          "width": "half",
          "autocomplete": "family-name"
        },
        {
          "kind": "email",
          "name": "email",
          "label": "Email",
          "required": true,
          "width": "half"
        },
        {
          "kind": "tel",
          "name": "phone",
          "label": "Phone",
          "required": true,
          "width": "half"
        },
        {
          "kind": "text",
          "name": "postcode",
          "label": "Postcode",
          "required": true,
          "width": "half",
          "autocomplete": "postal-code"
        },
        {
          "kind": "select",
          "name": "rooms",
          "label": "What are you seeing?",
          "required": true,
          "width": "half",
          "choices": [
            "Scorpions",
            "Ants or roaches",
            "Termites",
            "Rats or mice",
            "Wasps, bees or mosquitoes",
            "Not sure"
          ]
        },
        {
          "kind": "textarea",
          "name": "message",
          "label": "Anything we should know",
          "placeholder": "Where you see them, for how long, pets or kids in the home",
          "rows": 5,
          "required": false
        },
        {
          "kind": "checkbox",
          "name": "consent",
          "label": "You can text me about this inspection. See the [privacy policy](/privacy).",
          "required": true
        },
        {
          "kind": "hidden",
          "name": "source",
          "value": "contact-page"
        }
      ],
      "footnote": "We use your details to arrange the inspection and nothing else. No lists, no resale.",
      "surface": "muted",
      "spacing": "md",
      "width": "default"
    },
    {
      "type": "contact_details",
      "headingLevel": "h2",
      "eyebrow": "Where to find us",
      "heading": "Find the office.",
      "showPhone": true,
      "showEmail": true,
      "showAddress": true,
      "showHours": true,
      "extra": [
        {
          "label": "Service area",
