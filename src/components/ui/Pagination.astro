---
/**
 * Pagination for collection index pages.
 *
 * Real links, not buttons, so they open in a new tab, get crawled, and work
 * without JavaScript. Long runs collapse to first / neighbours / last rather
 * than printing ninety numbers.
 */
interface Props {
	current: number;
	total: number;
	/** Called with a page number; returns the URL for it. */
	href: (page: number) => string;
	/** How many pages to show either side of the current one. */
	spread?: number;
	class?: string;
}

const { current, total, href, spread = 1, class: className = '' } = Astro.props;

type Item = number | 'gap';

function buildRange(current: number, total: number, spread: number): Item[] {
	if (total <= 1) return [];

	const pages = new Set<number>([1, total]);
	for (let i = current - spread; i <= current + spread; i++) {
		if (i >= 1 && i <= total) pages.add(i);
	}

	const sorted = [...pages].sort((a, b) => a - b);
	const out: Item[] = [];

	sorted.forEach((page, i) => {
		// A single missing page is printed rather than replaced by an ellipsis:
		// a gap standing in for one number wastes the space it saves.
		const prev = sorted[i - 1];
		if (i > 0 && page - prev === 2) out.push(prev + 1);
		else if (i > 0 && page - prev > 2) out.push('gap');
		out.push(page);
	});

	return out;
}

const items = buildRange(current, total, spread);
const hasPrev = current > 1;
const hasNext = current < total;

const link =
	'inline-flex h-10 min-w-10 items-center justify-center rounded-(--radius-brand) px-3 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.12em] transition-colors';
---

{total > 1 && (
	<nav aria-label="Pagination" class={`flex items-center justify-center gap-1.5 ${className}`}>
		<a
			href={hasPrev ? href(current - 1) : undefined}
			class={`${link} ${
				hasPrev
					? 'border border-line text-ink hover:border-line'
					: 'pointer-events-none border border-line opacity-35'
			}`}
			aria-disabled={hasPrev ? undefined : 'true'}
			rel={hasPrev ? 'prev' : undefined}
		>
			<span aria-hidden="true">&larr;</span>
			<span class="sr-only">Previous page</span>
		</a>

		<ol class="flex items-center gap-1.5">
			{items.map((item) =>
				item === 'gap' ? (
					<li aria-hidden="true" class="px-1 font-mono text-xs opacity-40">
						&hellip;
					</li>
				) : (
					<li>
						<a
							href={href(item)}
							class={`${link} ${
								item === current
									? 'bg-brand text-brand-fg'
									: 'border border-line text-ink hover:border-line'
							}`}
							aria-current={item === current ? 'page' : undefined}
						>
							<span class="sr-only">Page </span>
							{item}
						</a>
					</li>
				)
			)}
		</ol>

		<a
			href={hasNext ? href(current + 1) : undefined}
			class={`${link} ${
				hasNext
					? 'border border-line text-ink hover:border-line'
					: 'pointer-events-none border border-line opacity-35'
			}`}
			aria-disabled={hasNext ? undefined : 'true'}
			rel={hasNext ? 'next' : undefined}
		>
			<span class="sr-only">Next page</span>
			<span aria-hidden="true">&rarr;</span>
		</a>
	</nav>
)}
