---
/**
 * The signature device: the specimen tag.
 *
 * A solid marker, a monospace label and a crosshair-terminated hairline,
 * lifted from field-guide plates and inspection reports (styles live in
 * global.css as `.dim`). Used as section eyebrow, divider, and photo
 * annotation -- it states what the business does: find it, name it, mark it.
 */
interface Props {
	/** The callout text. Real specimen or report labels read better than invented ones. */
	label: string;
	/** `short` keeps the rule to a fixed stub; `full` spans remaining width. */
	rule?: 'short' | 'full' | 'both' | 'none';
	/** Animate the rule drawing itself out on reveal. */
	animate?: boolean;
	/** Switches to the full signal green, which is the legible one on dark. */
	onDark?: boolean;
	class?: string;
}

const {
	label,
	rule = 'short',
	animate = false,
	onDark = false,
	class: className = '',
} = Astro.props;
---

<div class={`dim ${animate ? 'dim-animate' : ''} ${onDark ? 'dim-on-dark' : ''} ${className}`}>
	{(rule === 'short' || rule === 'both') && <span class="dim-rule dim-rule-short" />}
	<span class="whitespace-nowrap">{label}</span>
	{(rule === 'full' || rule === 'both') && <span class="dim-rule" />}
</div>
