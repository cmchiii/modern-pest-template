---
import { site } from '../../lib/site';
import Button from '../ui/Button.astro';

const year = new Date().getFullYear();
const address = site.contact.address;
---

<footer class="on-dark bg-dark text-dark-fg">
	<div class="edge-rule h-1" aria-hidden="true"></div>

	<div class="mx-auto w-full max-w-[104rem] px-5 sm:px-8 lg:px-12">
		{/*
			Closing call to action: one line of reassurance and the two ways to
			book, before the directory below.
		*/}
		<div class="grid items-center gap-8 border-b border-current/12 py-14 lg:grid-cols-[1fr_auto] lg:py-16">
			<div>
				<p class="text-[clamp(1.75rem,3.2vw,2.75rem)] leading-[1.05] font-semibold tracking-[-0.03em]">
					Ready when you are.
					<span class="mark-on-dark">Free inspection, no contract.</span>
				</p>
				{site.contact.hours && <p class="mt-3 text-sm text-dark-fg/65">{site.contact.hours}</p>}
			</div>
			<div class="flex flex-wrap items-center gap-3">
				{site.primaryCta && <Button {...site.primaryCta} style="accent" size="lg" />}
				<Button
					label={site.contact.phone}
					href={site.contact.phoneHref}
					style="secondary"
					size="lg"
					onDark
				/>
			</div>
		</div>

		<div class="grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
			<div class="sm:col-span-2 lg:col-span-1">
				{site.logoOnDark ? (
					<img src={site.logoOnDark.src} alt={site.logoOnDark.alt} class="h-11 w-auto" />
				) : site.logo ? (
					/* No light logo set: knock the header logo out to white for the dark ground. */
					<img src={site.logo.src} alt={site.logo.alt} class="h-11 w-auto brightness-0 invert" />
				) : (
					<p class="text-2xl font-semibold tracking-tight">{site.name}</p>
				)}
				{site.tagline && (
					<p class="mt-5 max-w-xs text-sm leading-relaxed text-dark-fg/70">{site.tagline}</p>
				)}

				<dl class="mt-7 space-y-3 text-sm">
					{site.contact.email && (
						<div class="flex gap-3">
							<dt class="w-16 shrink-0 text-dark-fg/50">Email</dt>
							<dd>
								<a href={`mailto:${site.contact.email}`} class="hover:text-accent">
									{site.contact.email}
								</a>
							</dd>
						</div>
					)}
					{address && (
						<div class="flex gap-3">
							<dt class="w-16 shrink-0 text-dark-fg/50">Office</dt>
							<dd>
								<address class="not-italic">
									{address.street}, {address.city}, {address.region} {address.postalCode}
								</address>
							</dd>
						</div>
					)}
				</dl>

				{site.social.length > 0 && (
					<ul class="mt-7 flex gap-2">
						{site.social.map((s) => (
							<li>
								<a
									href={s.href}
									class="inline-flex items-center border border-current/20 px-3 py-1.5 text-xs font-medium text-dark-fg/80 transition-colors hover:border-accent hover:text-accent"
									target="_blank"
									rel="noopener noreferrer"
								>
									{s.platform}
								</a>
							</li>
						))}
					</ul>
				)}
			</div>

			{site.footer.columns.map((column) => (
				<div>
					<p class="mb-5 text-sm font-semibold">{column.title}</p>
					<ul class="space-y-3 text-sm">
						{column.links.map((link) => (
							<li>
								<a href={link.href} class="text-dark-fg/70 transition-colors hover:text-accent">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="flex flex-col gap-4 border-t border-current/12 py-7 text-xs text-dark-fg/55 sm:flex-row sm:items-center sm:justify-between">
			<p>
				&copy; {year} {site.legalName ?? site.name}. All rights reserved.
			</p>
			<ul class="flex flex-wrap gap-x-6 gap-y-2">
				{site.footer.legal.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-accent">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</footer>
