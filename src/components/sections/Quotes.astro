---
import type { Quotes } from './Quotes.schema';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { site } from '../../lib/site';

type Props = Quotes;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	items = [],
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
const [lead, ...rest] = items;
const score = site.rating;

const stars = (value: number) => Math.round(value);
const initials = (name: string) =>
	name
		.split(/\s+/)
		.map((part) => part.charAt(0))
		.join('')
		.slice(0, 2);
const card = onDark ? 'border-current/15 bg-current/[0.05]' : 'border-line bg-surface';
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead eyebrow={eyebrow} heading={heading} level={headingLevel} onDark={onDark} />

	{/*
		Review wall: the overall score fills a full-height panel taking about a
		quarter of the row, closing on the booking action; the first
		review leads as a featured card with the words in the serif italic, and
		the rest follow as a two-up grid of smaller cards.
	*/}
	<div
		class={score ? 'grid gap-6 lg:grid-cols-[minmax(17rem,1fr)_minmax(0,2.75fr)] lg:gap-x-6' : ''}
	>
		{score && (
			<aside class="flex flex-col bg-brand p-8 text-brand-fg lg:p-10">
				<p class="mono-label text-brand-fg/70">Customer rating</p>
				<p class="mt-5 text-7xl leading-none font-semibold tracking-[-0.04em] lg:text-8xl">
					{score.value.toFixed(1)}
				</p>
				<p class="mt-3 text-lg tracking-[0.12em] text-accent" aria-hidden="true">
					{'★'.repeat(stars(score.value))}
					<span class="opacity-30">{'★'.repeat(5 - stars(score.value))}</span>
				</p>
				<p class="mt-2 text-sm text-brand-fg/80">
					{score.value.toFixed(1)} out of 5
					{score.count ? ` from ${score.count.toLocaleString()} verified Google reviews` : ''}
				</p>
				<p class="mt-8 border-t border-current/20 pt-5 text-sm leading-relaxed text-brand-fg/70 lg:mt-auto">
					Every review comes from a customer we have actually serviced.
				</p>
				{site.primaryCta && (
					<div class="mt-6">
						<Button {...site.primaryCta} style="accent" class="w-full" />
					</div>
				)}
			</aside>
		)}

		<div class="grid gap-6">
			{lead && (
				<figure class={`border p-8 sm:p-10 ${card}`}>
					{lead.rating !== undefined && (
						<p
							class="text-base tracking-[0.12em] text-cta"
							role="img"
							aria-label={`${lead.rating} out of 5`}
						>
							{'★'.repeat(stars(lead.rating))}
						</p>
					)}
					<blockquote
						class={`mt-5 font-serif text-[clamp(1.75rem,3.2vw,2.6rem)] leading-[1.18] italic ${onDark ? '' : 'text-ink'}`}
					>
						&ldquo;{lead.quote}&rdquo;
					</blockquote>
					<figcaption class="mt-8 flex items-center gap-4">
						<span
							class="flex h-12 w-12 shrink-0 items-center justify-center bg-muted text-sm font-semibold text-brand"
							aria-hidden="true"
						>
							{initials(lead.name)}
						</span>
						<span>
							<span class="block font-semibold">{lead.name}</span>
							{lead.location && <span class="block text-sm opacity-65">{lead.location}</span>}
						</span>
					</figcaption>
				</figure>
			)}

			{rest.length > 0 && (
				<ul class="grid gap-6 md:grid-cols-2">
					{rest.map((item) => (
						<li>
							<figure class={`flex h-full flex-col border p-7 ${card}`}>
								{item.rating !== undefined && (
									<p
										class="text-sm tracking-[0.12em] text-cta"
										role="img"
										aria-label={`${item.rating} out of 5`}
									>
										{'★'.repeat(stars(item.rating))}
										<span class="opacity-25">{'★'.repeat(5 - stars(item.rating))}</span>
									</p>
								)}
								<blockquote
									class={`mt-4 flex-1 text-[1.0625rem] leading-relaxed ${onDark ? '' : 'text-ink'}`}
								>
									&ldquo;{item.quote}&rdquo;
								</blockquote>
								<figcaption
									class={`mt-6 flex items-center gap-3 border-t pt-5 ${onDark ? 'border-current/15' : 'border-line'}`}
								>
									<span
										class="flex h-10 w-10 shrink-0 items-center justify-center bg-muted text-xs font-semibold text-brand"
										aria-hidden="true"
									>
										{initials(item.name)}
									</span>
									<span>
										<span class="block text-sm font-semibold">{item.name}</span>
										{item.location && <span class="block text-xs opacity-65">{item.location}</span>}
									</span>
								</figcaption>
							</figure>
						</li>
					))}
				</ul>
			)}
		</div>
	</div>
</Section>
