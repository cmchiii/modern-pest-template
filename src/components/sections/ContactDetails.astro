---
import type { ContactDetails } from './ContactDetails.schema';
import Section from '../ui/Section.astro';
import Media from '../ui/Media.astro';
import SectionHead from '../ui/SectionHead.astro';
import { site } from '../../lib/site';

type Props = ContactDetails;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	showPhone = true,
	showEmail = true,
	showAddress = true,
	showHours = true,
	extra = [],
	media,
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
const address = site.contact.address;

// Built from global settings so a changed phone number changes every page at
// once. The toggles decide what appears here, not what the business is.
const lines: { label: string; value: string; href?: string }[] = [
	...(showPhone
		? [{ label: 'Phone', value: site.contact.phone, href: site.contact.phoneHref }]
		: []),
	...(showEmail && site.contact.email
		? [{ label: 'Email', value: site.contact.email, href: `mailto:${site.contact.email}` }]
		: []),
	...(showAddress && address
		? [
				{
					label: 'Address',
					value: `${address.street}, ${address.city}, ${address.region} ${address.postalCode}`,
				},
			]
		: []),
	...(showHours && site.contact.hours ? [{ label: 'Hours', value: site.contact.hours }] : []),
	...extra,
];
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	{/*
		The office card sits over a wide, softly tinted map: details first on
		small screens, the card floating over the map's left edge on large ones.
	*/}
	<div class={media ? 'relative lg:min-h-[30rem]' : ''}>
		{media && (
			<div class="relative overflow-hidden border border-line lg:absolute lg:inset-0 [&_iframe]:h-full [&_iframe]:min-h-[22rem] [&_img]:h-full">
				<Media media={media} class="grayscale" />
				<span
					class="pointer-events-none absolute inset-0 bg-brand/15 mix-blend-multiply"
					aria-hidden="true"
				/>
			</div>
		)}

		<dl
			class={`relative z-[1] grid gap-y-5 p-7 sm:p-8 ${
				media
					? 'bg-surface text-ink shadow-[0_24px_48px_-24px_rgba(15,27,51,0.45)] lg:absolute lg:top-8 lg:left-8 lg:w-[24rem]'
					: ''
			} ${!media && onDark ? '' : 'border border-line'}`}
		>
			{lines.map((line) => (
				<div class="grid grid-cols-[6rem_1fr] gap-4 border-b border-line pb-5 last:border-b-0 last:pb-0">
					<dt class="mono-label pt-0.5 text-brand">{line.label}</dt>
					<dd class="text-[0.9375rem] leading-relaxed">
						{line.href ? (
							<a
								href={line.href}
								class="font-semibold text-ink underline decoration-brand/30 underline-offset-4 hover:decoration-brand"
							>
								{line.value}
							</a>
						) : (
							line.value
						)}
					</dd>
				</div>
			))}
		</dl>
	</div>
</Section>
