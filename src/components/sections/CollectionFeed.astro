---
import { getCollection } from 'astro:content';
import type { CollectionFeed } from './CollectionFeed.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { childLevel } from '../../lib/section-base';
import { collectionBasePath, entrySlug } from '../../lib/collections';

type Props = CollectionFeed;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	source,
	layout = 'grid',
	columns = '3',
	limit = 0,
	topLevelOnly = false,
	showImage = true,
	showSummary = true,
	showPrice = true,
	moreLabel,
	moreHref,
	moreStyle = 'ghost',
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

// Drafts are visible while writing and gone in production, matching how the
// pages collection behaves.
const entries = await getCollection(source, ({ data }) =>
	import.meta.env.PROD ? !data.draft : true
);

// Sub-services carry a `parent`; top-level categories do not. This keeps the
// services index to the main rooms instead of every child page.
const filtered = topLevelOnly
	? entries.filter((entry) => !('parent' in entry.data && entry.data.parent))
	: entries;

filtered.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const shown = limit > 0 ? filtered.slice(0, limit) : filtered;
const base = collectionBasePath[source];

const gridCols = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
	'5': 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
};
const isList = layout === 'list';
// The double lead tile only works when there are tiles to stack beside it.
const bento = !isList && columns === '3' && shown.length >= 3;
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	{shown.length === 0 ? (
		/* An empty collection is a content state, not an error. Say so plainly
			   rather than rendering an empty grid. */
		<p class="text-sm opacity-70">Nothing published here yet.</p>
	) : isList ? (
		<ul class={`border-y ${onDark ? 'border-current/40' : 'border-line'}`}>
			{shown.map((entry, i) => (
				<li
					class={`group relative flex flex-wrap items-baseline gap-x-6 gap-y-2 border-b py-5 last:border-b-0 ${onDark ? 'border-current/15' : 'border-line/20'}`}
				>
					<span class="font-mono text-xs opacity-60">{String(i + 1).padStart(2, '0')}</span>
					<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm" class="flex-1">
						<a
							href={`${base}/${entrySlug(entry.id)}`}
							class="transition-colors hover:text-accent-ink"
						>
							<span class="absolute inset-0" aria-hidden="true" />
							{entry.data.title}
						</a>
					</Heading>
					{showPrice && 'priceNote' in entry.data && entry.data.priceNote && (
						<span class="mono-label opacity-65">{entry.data.priceNote}</span>
					)}
					{showSummary && (
						<p class="w-full max-w-prose pl-10 text-sm leading-relaxed opacity-80">
							{entry.data.summary}
						</p>
					)}
				</li>
			))}
		</ul>
	) : (
		/*
			Case-file bento: the lead entry takes a double tile, the rest stack
			beside it. Each tile is the specimen photo under photo with the file
			tab, metadata and title set on a black foot bar.
		*/
		<ul
			class={`grid gap-4 ${gridCols[columns]} ${bento ? 'lg:auto-rows-[minmax(20rem,auto)]' : ''}`}
		>
			{shown.map((entry, i) => {
				const lead = bento && i === 0;
				const meta = [
					'location' in entry.data ? entry.data.location : undefined,
					'priceNote' in entry.data && showPrice ? entry.data.priceNote : undefined,
				].filter(Boolean);
				return (
					<li
						class={`on-dark group relative isolate flex min-h-[20rem] flex-col justify-end overflow-hidden border border-line bg-dark text-dark-fg [&_:is(h1,h2,h3,h4)]:!text-dark-fg ${
							lead ? 'lg:col-span-2 lg:row-span-2' : ''
						}`}
					>
						{showImage && entry.data.image && (
							<div class="photo absolute inset-0 -z-10">
								<img
									src={entry.data.image.src}
									alt={entry.data.image.alt}
									loading="lazy"
									class="h-full w-full object-cover opacity-85 transition-transform duration-700 ease-out group-hover:scale-110"
								/>
							</div>
						)}
						<span class="mono-label absolute top-5 left-5 bg-surface px-2.5 py-1 text-ink">
							{source === 'projects' ? 'Case study' : 'Service'} {String(i + 1).padStart(2, '0')}
						</span>
						<div class="bg-gradient-to-t from-dark via-dark/85 to-transparent p-5 pt-16 sm:p-7 sm:pt-20">
							{meta.length > 0 && <p class="mono-label mb-2 opacity-70">{meta.join(' · ')}</p>}
							<Heading
								level={childLevel(headingLevel, Boolean(heading))}
								size={lead ? 'lg' : 'sm'}
								display={lead}
							>
								<a href={`${base}/${entrySlug(entry.id)}`}>
									<span class="absolute inset-0 z-[1]" aria-hidden="true" />
									{entry.data.title}
								</a>
							</Heading>
							{showSummary && (
								<p
									class={`mt-2 text-sm leading-relaxed opacity-80 ${lead ? 'max-w-lg' : 'line-clamp-2'}`}
								>
									{entry.data.summary}
								</p>
							)}
						</div>
					</li>
				);
			})}
		</ul>
	)}

	{moreLabel && moreHref && (
		<div class="mt-12">
			<Button label={moreLabel} href={moreHref} style={moreStyle} arrow onDark={onDark} />
		</div>
	)}
</Section>
