---
import type { MediaSplit } from './MediaSplit.schema';
import Section from '../ui/Section.astro';
import Prose from '../ui/Prose.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import { iconPaths } from '../../lib/icons';

type Props = MediaSplit;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	body,
	image,
	imageSide = 'right',
	bullets = [],
	ctas = [],
	anchor,
	surface = 'light',
	spacing = 'md',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
// Source order stays text-then-image so the heading is read first; only the
// visual order flips.
const imageFirst = imageSide === 'left';

// A bullet is a bare string or a { text, desc, icon } object. Normalise so the
// markup reads one shape.
const items = bullets.map((b) =>
	typeof b === 'string' ? { text: b, desc: undefined, icon: undefined } : b
);

const pad = { none: 'lg:py-0', sm: 'lg:py-16', md: 'lg:py-24', lg: 'lg:py-32' }[spacing];
---

<Section anchor={anchor} surface={surface} spacing="none" width="full" contained={false}>
	{/*
		Edge-to-edge halves: the specimen plate bleeds to the screen edge on its
		side, the report copy sits in the other half. Each plate is numbered as a
		figure (CSS counter) with its alt text as the caption.
	*/}
	<div class={`grid ${image ? 'lg:grid-cols-2' : ''}`}>
		<div
			class={`flex items-center px-5 py-16 sm:px-8 lg:px-16 xl:px-24 ${pad} ${imageFirst ? 'lg:order-2' : ''}`}
		>
			<div class="w-full max-w-2xl">
				<SectionHead
					eyebrow={eyebrow}
					heading={heading}
					level={headingLevel}
					onDark={onDark}
					stacked
					size="lg"
					class="!mb-8"
				/>

				{body && <Prose html={body} invert={onDark} />}

				{items.length > 0 && (
					<ol class={`mt-10 border-t ${onDark ? 'border-current/40' : 'border-line'}`}>
						{items.map((item, i) => (
							<li
								class={`grid grid-cols-[3rem_1fr_auto] items-start gap-4 border-b py-4 ${
									onDark ? 'border-current/15' : 'border-line/20'
								}`}
							>
								<span
									class={`font-mono text-sm font-semibold ${onDark ? 'text-accent' : 'text-accent-ink'}`}
								>
									{String(i + 1).padStart(2, '0')}
								</span>
								<span>
									<span class={`block font-semibold ${item.desc ? 'text-base' : 'text-sm'}`}>
										{item.text}
									</span>
									{item.desc && (
										<span class="mt-1 block text-sm leading-relaxed opacity-70">{item.desc}</span>
									)}
								</span>
								{item.icon && (
									<svg
										viewBox="0 0 24 24"
										class="mt-0.5 h-5 w-5 opacity-40"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="square"
										aria-hidden="true"
									>
										<path d={iconPaths[item.icon]} />
									</svg>
								)}
							</li>
						))}
					</ol>
				)}

				{ctas.length > 0 && (
					<div class="mt-10 flex flex-wrap items-center gap-4">
						{ctas.map((cta) => (
							<Button {...cta} onDark={onDark} arrow={cta.style !== 'secondary'} />
						))}
					</div>
				)}
			</div>
		</div>

		{image && (
			<figure
				class={`photo relative min-h-[24rem] overflow-hidden bg-dark sm:min-h-[30rem] ${imageFirst ? 'lg:order-1' : ''}`}
			>
				<img
					src={image.src}
					alt={image.alt}
					loading="lazy"
					class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.6s] ease-out hover:scale-105"
				/>
				<span class="inset-frame pointer-events-none absolute inset-5 z-[2]" aria-hidden="true" />
				<figcaption class="absolute inset-x-0 bottom-0 z-[3] flex items-center gap-4 border-t border-accent bg-dark px-5 py-3 font-mono text-[0.6875rem] tracking-[0.14em] text-dark-fg/80 uppercase sm:px-8">
					<span class="fig-num shrink-0 font-semibold text-accent" />
					<span class="truncate">{image.alt}</span>
				</figcaption>
			</figure>
		)}
	</div>
</Section>
