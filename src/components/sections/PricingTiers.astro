---
import type { PricingTiers } from './PricingTiers.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import { childLevel } from '../../lib/section-base';
import { iconPaths } from '../../lib/icons';

type Props = PricingTiers;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	toggle,
	tiers = [],
	footnote,
	anchor,
	surface = 'muted',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
const cardLevel = childLevel(headingLevel, Boolean(heading));

// Every row carries both price sets in the markup; the toggle only flips which
// is shown, so a reader with JS off still sees the primary price rather than a
// dead switch. The alt figures fall back to the primary when a tier leaves them
// off, so a partly-filled toggle never blanks a card.
const hasToggle = Boolean(toggle);

// The featured row is dark navy, where a navy `primary` button disappears.
// Promote it to `accent`, the orange CTA that reads on any surface. An explicitly authored non-primary style
// (secondary/ghost/accent) is still honoured. Mirrors the same promotion in
// CtaBanner.
const tierCtaStyle = (tier: (typeof tiers)[number]) =>
	tier.featured && (!tier.cta?.style || tier.cta.style === 'primary') ? 'accent' : tier.cta?.style;
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	{toggle && (
		<div class="mb-10 flex flex-wrap items-center gap-4" data-pricing-toggle data-mode="primary">
			<div
				class={`inline-flex rounded-(--radius-brand) border p-1 ${
					onDark ? 'border-current/25' : 'border-line bg-surface'
				}`}
				role="group"
				aria-label="Billing option"
			>
				<button
					type="button"
					data-toggle-primary
					aria-pressed="true"
					class="min-h-9 rounded-[calc(var(--radius-brand)-0.25rem)] px-5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.14em] transition-colors"
				>
					{toggle.primaryLabel}
				</button>
				<button
					type="button"
					data-toggle-alt
					aria-pressed="false"
					class="min-h-9 rounded-[calc(var(--radius-brand)-0.25rem)] px-5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.14em] transition-colors"
				>
					{toggle.altLabel}
				</button>
			</div>
			{toggle.note && (
				<p class="font-mono text-[0.6875rem] tracking-[0.08em] opacity-65">{toggle.note}</p>
			)}
		</div>
	)}

	{/*
		Plan rows rather than a card trio: name and fit on the left, what is
		included as a two-column checklist in the middle, price and action on
		the right. The featured plan is the inverted row. Both price sets live in
		the DOM; the toggle script swaps which one shows.
	*/}
	<ul class={`border-t ${onDark ? 'border-current/20' : 'border-line'}`}>
		{tiers.map((tier) => (
			<li
				class={`tier relative grid gap-8 border-b px-5 py-9 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)_minmax(14rem,0.7fr)] lg:items-center lg:gap-12 ${
					tier.featured
						? 'tier-featured on-dark border-transparent bg-dark text-dark-fg'
						: onDark
							? 'border-current/20'
							: 'border-line'
				}`}
			>
				<div>
					{tier.badge && (
						<span
							class={`mono-label mb-3 inline-block px-2.5 py-1 ${
								tier.featured ? 'bg-accent text-accent-fg' : 'bg-muted text-brand'
							}`}
						>
							{tier.badge}
						</span>
					)}
					<Heading level={cardLevel} size="md" class="text-current">
						{tier.name}
					</Heading>
					{tier.note && <p class="mt-2 text-sm leading-relaxed opacity-75">{tier.note}</p>}
				</div>

				{tier.features.length > 0 ? (
					<ul class="grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
						{tier.features.map((feature) => (
							<li class="flex items-start gap-2.5 text-sm leading-relaxed">
								<svg
									viewBox="0 0 24 24"
									class={`mt-0.5 h-4 w-4 shrink-0 ${tier.featured ? 'text-accent' : 'text-accent-ink'}`}
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d={iconPaths.check} />
								</svg>
								<span class={tier.featured ? '' : 'opacity-85'}>{feature}</span>
							</li>
						))}
					</ul>
				) : (
					<span />
				)}

				<div class="lg:text-right">
					{tier.priceLabel && <span class="mono-label block opacity-60">{tier.priceLabel}</span>}
					<span class="mt-1 flex items-baseline gap-1.5 lg:justify-end">
						<span
							class="text-[clamp(2.25rem,3.6vw,3rem)] leading-none font-semibold tracking-[-0.03em]"
							data-price-primary={tier.price}
							data-price-alt={hasToggle ? (tier.priceAlt ?? tier.price) : undefined}
						>
							{tier.price}
						</span>
						{(tier.priceUnit || tier.priceAltUnit) && (
							<span
								class="text-sm opacity-70"
								data-unit-primary={tier.priceUnit ?? ''}
								data-unit-alt={hasToggle ? (tier.priceAltUnit ?? tier.priceUnit ?? '') : undefined}
							>
								{tier.priceUnit}
							</span>
						)}
					</span>
					{tier.cta && (
						<div class="mt-5">
							<Button
								{...tier.cta}
								style={tierCtaStyle(tier)}
								onDark={tier.featured || onDark}
								class="w-full lg:w-auto"
							/>
						</div>
					)}
				</div>
			</li>
		))}
	</ul>

	{footnote && (
		<p class={`mt-8 text-xs leading-relaxed ${onDark ? 'opacity-70' : 'opacity-60'}`}>{footnote}</p>
	)}
</Section>

<style>
	/*
	 * The featured tier is always the black card, whatever surface the
	 * section sits on. On a light or muted section, though, the Section wrapper
	 * sets every heading inside it to that surface's DARK heading colour via a
	 * `[& :is(h1..h4)]` descendant rule -- which also reaches the title inside the
	 * dark featured card, rendering dark-on-dark. The tier name carries `.text-current`,
	 * but a utility class cannot outrank that descendant selector.
	 *
	 * `:global` reaches across to the Heading child component, and the scoped
	 * `.tier-featured` attribute gives this enough specificity to win, so the
	 * featured title always reads in the paper foreground. (Mirrors the same fix
	 * in Offers.astro's coupon-featured card.)
	 */
	.tier-featured :global(:is(h1, h2, h3, h4)) {
		color: var(--color-dark-fg);
	}
</style>

<script>
	// Flips every card between its primary and alt price set. Purely a display
	// swap of text already in the DOM, so nothing is fetched and JS-off readers
	// keep the primary price.
	document.querySelectorAll('[data-pricing-toggle]').forEach((group) => {
		if (!(group instanceof HTMLElement)) return;

		const primaryBtn = group.querySelector<HTMLButtonElement>('[data-toggle-primary]');
		const altBtn = group.querySelector<HTMLButtonElement>('[data-toggle-alt]');
		const section = group.closest('section');
		if (!primaryBtn || !altBtn || !section) return;

		const activeClasses = ['bg-brand', 'text-brand-fg'];

		const paint = (mode: 'primary' | 'alt') => {
			const on = mode === 'primary' ? primaryBtn : altBtn;
			const off = mode === 'primary' ? altBtn : primaryBtn;
			on.classList.add(...activeClasses);
			on.setAttribute('aria-pressed', 'true');
			off.classList.remove(...activeClasses);
			off.setAttribute('aria-pressed', 'false');

			section.querySelectorAll<HTMLElement>('[data-price-primary]').forEach((el) => {
				const next = mode === 'primary' ? el.dataset.pricePrimary : el.dataset.priceAlt;
				if (next != null) el.textContent = next;
			});
			section.querySelectorAll<HTMLElement>('[data-unit-primary]').forEach((el) => {
				const next = mode === 'primary' ? el.dataset.unitPrimary : el.dataset.unitAlt;
				if (next != null) el.textContent = next;
			});
		};

		// Paint the starting state so the active button reads as selected on load.
		paint('primary');
		primaryBtn.addEventListener('click', () => paint('primary'));
		altBtn.addEventListener('click', () => paint('alt'));
	});
</script>
