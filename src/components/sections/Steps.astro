---
import type { Steps } from './Steps.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { childLevel } from '../../lib/section-base';
import SectionHead from '../ui/SectionHead.astro';

type Props = Steps;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	steps = [],
	anchor,
	surface = 'muted',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	{/*
		A connected timeline: navy number tiles joined by a track line, each step
		on its own card beneath. An ordered list, because the order carries the
		information; the numbers come from the markup, so reordering in the CMS
		renumbers correctly.
	*/}
	<ol class="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		<span
			class={`absolute top-6 right-[12%] left-[12%] hidden h-px lg:block ${onDark ? 'bg-current/25' : 'bg-line'}`}
			aria-hidden="true"
		/>
		{steps.map((step, i) => (
			<li class="relative flex flex-col items-start">
				<span
					class={`relative z-[1] flex h-12 w-12 items-center justify-center text-lg font-semibold tabular-nums ${
						onDark ? 'bg-accent text-accent-fg' : 'bg-brand text-brand-fg'
					}`}
				>
					{i + 1}
				</span>
				<div
					class={`mt-5 w-full flex-1 border p-6 ${
						onDark ? 'border-current/15 bg-current/[0.04]' : 'border-line bg-surface'
					}`}
				>
					<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
						{step.title}
					</Heading>
					{step.body && <p class="mt-2.5 text-sm leading-relaxed">{step.body}</p>}
				</div>
			</li>
		))}
	</ol>
</Section>
