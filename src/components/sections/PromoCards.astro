---
import type { PromoCards } from './PromoCards.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import { childLevel } from '../../lib/section-base';
import { iconPaths } from '../../lib/icons';

type Props = PromoCards;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	cards = [],
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
const cardLevel = childLevel(headingLevel, Boolean(heading));

const gridCols = { '2': 'md:grid-cols-2', '3': 'md:grid-cols-2 lg:grid-cols-3' };

// Wrap panels butted edge to edge, each in its own ground: black, safety
// yellow, white -- cycling, so the row reads as one truck panel of three. The text colour is set per panel, not by the
// section, so the panels look the same on any surface.
const grounds = [
	{ panel: 'on-dark bg-dark text-dark-fg', accent: 'text-accent', onDarkCta: true },
	{ panel: 'bg-brand text-brand-fg', accent: 'text-accent', onDarkCta: false },
	{ panel: 'bg-surface text-ink', accent: 'text-accent-ink', onDarkCta: false },
];
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	<ul class={`grid border-t border-l border-line ${gridCols[columns]}`}>
		{cards.map((card, i) => {
			const g = grounds[i % grounds.length];
			return (
				<li
					class={`flex flex-col border-r border-b border-line ${g.panel} [&_:is(h3,h4)]:!text-current`}
				>
					<div class="flex items-center justify-between gap-4 border-b border-current/80 px-6 py-3">
						<span class="mono-label font-semibold">
							{card.badge ?? `Notice ${String(i + 1).padStart(2, '0')}`}
						</span>
						{card.icon && (
							<svg
								viewBox="0 0 24 24"
								class="h-6 w-6"
								fill="none"
								stroke="currentColor"
								stroke-width="2.25"
								stroke-linecap="square"
								aria-hidden="true"
							>
								<path d={iconPaths[card.icon]} />
							</svg>
						)}
					</div>

					{card.image && (
						<div class="photo relative aspect-[16/9] overflow-hidden border-b border-current/80 bg-dark">
							<img
								src={card.image.src}
								alt={card.image.alt}
								loading="lazy"
								class="h-full w-full object-cover"
							/>
						</div>
					)}

					<div class="flex flex-1 flex-col px-6 pt-7 pb-6">
						{card.subtitle && <p class="mono-label mb-3 opacity-70">{card.subtitle}</p>}
						<Heading level={cardLevel} size="lg" display class="!leading-[0.88]">
							{card.title}
						</Heading>

						{card.price && (
							<p class="mt-5 flex items-baseline gap-3">
								{card.price.label && <span class="mono-label opacity-70">{card.price.label}</span>}
								<span class={`font-display text-6xl leading-none font-black ${g.accent}`}>
									{card.price.value}
								</span>
								{card.price.unit && <span class="mono-label opacity-70">{card.price.unit}</span>}
							</p>
						)}

						{card.body && <p class="mt-4 text-sm leading-relaxed opacity-85">{card.body}</p>}

						{(card.cta || card.phone) && (
							<div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-7">
								{card.cta && <Button {...card.cta} size="sm" onDark={g.onDarkCta} arrow />}
								{card.phone && (
									<a
										href={card.phoneHref ?? `tel:${card.phone.replace(/[^\d+]/g, '')}`}
										class="font-mono text-xs font-semibold tracking-[0.08em] underline decoration-2 underline-offset-4"
									>
										{card.phone}
									</a>
								)}
							</div>
						)}
					</div>
				</li>
			);
		})}
	</ul>
</Section>
