---
import type { FeatureList } from './FeatureList.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { childLevel } from '../../lib/section-base';
import SectionHead from '../ui/SectionHead.astro';

type Props = FeatureList;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	items = [],
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

const gridCols = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	<ul class={`grid gap-4 ${gridCols[columns]}`}>
		{items.map((item, i) => (
			<li class={`p-7 ${onDark ? 'bg-current/[0.06]' : 'bg-muted'}`}>
				<span
					class={`mb-5 block text-sm font-semibold tabular-nums ${onDark ? 'text-accent' : 'text-brand'}`}
				>
					{String(i + 1).padStart(2, '0')}
				</span>
				<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
					{item.title}
				</Heading>
				{item.body && <p class="mt-3 text-sm leading-relaxed">{item.body}</p>}
			</li>
		))}
	</ul>
</Section>
