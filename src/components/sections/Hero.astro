---
import type { Hero } from './Hero.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Prose from '../ui/Prose.astro';
import Button from '../ui/Button.astro';
import HeroBackground from './HeroBackground.astro';

type Props = Hero;

const {
	headingLevel = 'h1',
	layout = 'split',
	eyebrow,
	heading,
	body,
	background,
	mediaNote,
	ctas = [],
	badges = [],
	rating,
	anchor,
	surface = 'light',
	spacing = 'lg',
	width = 'wide',
} = Astro.props;

const isFull = layout === 'full';
const centered = layout === 'centered';
const onDark = surface === 'dark' || surface === 'brand';

// Stacked sentences, one per line; every sentence after the first is set in
// the serif italic ("Nothing gets in. / Nothing stays.").
const sentences = heading.split(/(?<=[.!?])\s+/).filter(Boolean);
const stars = rating ? Math.round(rating.value) : 0;
const showStats = !centered && (rating || badges.length > 0);
---

<Section
	anchor={anchor}
	surface={surface}
	spacing={isFull ? 'md' : spacing}
	width={width}
	reveal={false}
>
	{/*
		Built from the same parts as the sections below it: copy on the left,
		the photo in a hairline-framed card on the right (caption beneath, like
		the case files), and a bordered stats grid under both -- the score and
		each credential in a cell, the same grid the plans and areas use.
	*/}
	<div
		class={
			centered
				? 'mx-auto max-w-3xl text-center'
				: 'grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16'
		}
	>
		<div>
			{eyebrow && (
				<p
					class={`mono-label mb-7 inline-flex items-center gap-2.5 px-3 py-1.5 ${
						onDark ? 'bg-current/10 text-accent' : 'bg-muted text-brand'
					}`}
				>
					<span class="check-dot" aria-hidden="true" />
					{eyebrow}
				</p>
			)}

			<Heading level={headingLevel} size="hero" display class="!text-[clamp(2.6rem,5vw,4.75rem)]">
				{sentences.map((s, i) => (
					<span class={`block ${i > 0 ? (onDark ? 'mark-on-dark' : 'mark') : ''}`}>{s}</span>
				))}
			</Heading>

			{body && (
				<Prose
					html={body}
					invert={onDark}
					size="lg"
					class={`mt-7 max-w-xl ${centered ? 'mx-auto' : ''}`}
				/>
			)}

			{ctas.length > 0 && (
				<div
					class={`mt-9 flex flex-wrap items-center gap-x-7 gap-y-3 ${centered ? 'justify-center' : ''}`}
				>
					{ctas.map((cta) => (
						<Button {...cta} size="lg" onDark={onDark} arrow={cta.style === 'ghost'} />
					))}
				</div>
			)}
		</div>

		{!centered && background && (
			<figure class={`border p-3 ${onDark ? 'border-current/15' : 'border-line bg-surface'}`}>
				<div class="relative isolate aspect-[4/3] overflow-hidden bg-dark">
					<HeroBackground background={background} scrim={false} />
				</div>
				{mediaNote && (
					<figcaption class="flex items-center gap-2.5 px-2 pt-3 pb-1 text-sm opacity-75">
						<span class="check-dot" aria-hidden="true" />
						{mediaNote}
					</figcaption>
				)}
			</figure>
		)}
	</div>

	{showStats && (
		<dl
			class={`mt-12 grid gap-px border sm:grid-cols-2 lg:mt-16 ${
				badges.length + (rating ? 1 : 0) >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'
			} ${onDark ? 'border-current/15 bg-current/15' : 'border-line bg-line'}`}
		>
			{rating && (
				<div class={`flex items-center gap-4 p-6 ${onDark ? 'bg-dark' : 'bg-surface'}`}>
					<dt class="sr-only">Customer rating</dt>
					<dd
						class={`text-4xl leading-none font-semibold tracking-[-0.03em] ${onDark ? '' : 'text-ink'}`}
					>
						{rating.value.toFixed(1)}
					</dd>
					<dd>
						<span class="block text-sm tracking-[0.1em] text-cta" aria-hidden="true">
							{'★'.repeat(stars)}
						</span>
						<span class="block text-xs opacity-70">
							{rating.count ? `${rating.count.toLocaleString()} ` : ''}
							{rating.label}
						</span>
					</dd>
				</div>
			)}
			{badges.map((badge, i) => (
				<div class={`flex items-center gap-3.5 p-6 ${onDark ? 'bg-dark' : 'bg-surface'}`}>
					<dt class="sr-only">Credential {i + 1}</dt>
					<span
						class={`flex h-10 w-10 shrink-0 items-center justify-center ${onDark ? 'bg-current/10' : 'bg-muted'}`}
						aria-hidden="true"
					>
						<span class="check-dot" />
					</span>
					<dd class="text-sm leading-snug font-medium">{badge}</dd>
				</div>
			))}
		</dl>
	)}
</Section>
