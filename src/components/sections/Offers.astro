---
import type { Offers } from './Offers.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import { childLevel } from '../../lib/section-base';

type Props = Offers;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	columns = '3',
	items = [],
	anchor,
	surface = 'muted',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';

/*
 * Expired offers are dropped at build time rather than hidden with CSS, so an
 * out-of-date coupon cannot be found in the markup or honoured by a customer
 * who screenshots it. Compared by date only: an offer expiring today is still
 * valid all day.
 */
const today = new Date();
today.setHours(0, 0, 0, 0);

const live = items.filter((item) => {
	if (!item.expires) return true;
	const expiry = new Date(item.expires);
	if (Number.isNaN(expiry.valueOf())) return true;
	expiry.setHours(0, 0, 0, 0);
	return expiry >= today;
});

const dateFormat = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});

// The lead offer (the one with a CTA, else the first) is the navy ticket.
const featuredIndex = (() => {
	const withCta = live.findIndex((item) => item.cta);
	return withCta === -1 ? 0 : withCta;
})();
---

{live.length > 0 && (
	<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
		<SectionHead
			eyebrow={eyebrow}
			heading={heading}
			intro={intro}
			level={headingLevel}
			onDark={onDark}
		/>

		{/*
			Tear-off coupons: the saving on the stub, a dashed tear line with a
			punched notch on each edge (a CSS mask, so it cuts through on any
			ground), then the offer, the code and the fine print. The lead offer
			is the navy ticket.
		*/}
		<ul
			class={`grid gap-6 ${columns === '2' ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3'}`}
		>
			{live.map((item, i) => {
				const featured = i === featuredIndex;
				return (
					<li class="coupon-shadow">
						<div
							class={`coupon flex h-full flex-col border ${
								featured
									? 'on-dark border-dark bg-dark text-dark-fg [&_:is(h3,h4)]:!text-dark-fg'
									: onDark
										? 'border-current/20 bg-current/[0.05]'
										: 'border-line bg-surface'
							}`}
						>
							<div class="flex h-[var(--stub)] flex-col justify-center px-7">
								<p class="mono-label flex items-center justify-between gap-4 opacity-70">
									<span>Coupon {String(i + 1).padStart(2, '0')}</span>
									{featured && (
										<span class="bg-accent px-2 py-0.5 text-accent-fg opacity-100">
											Most claimed
										</span>
									)}
								</p>
								{item.value && (
									<p
										class={`mt-2 text-[clamp(2.75rem,4.4vw,3.75rem)] leading-none font-semibold tracking-[-0.04em] ${
											featured || onDark ? 'text-accent' : 'text-accent-ink'
										}`}
									>
										{item.value}
									</p>
								)}
							</div>

							<div
								class={`mx-6 border-t-2 border-dashed ${featured || onDark ? 'border-current/25' : 'border-line'}`}
								aria-hidden="true"
							/>

							<div class="flex flex-1 flex-col px-7 pt-6 pb-7">
								<Heading level={childLevel(headingLevel, Boolean(heading))} size="sm">
									{item.title}
								</Heading>
								{item.body && <p class="mt-2 text-sm leading-relaxed opacity-80">{item.body}</p>}

								<div class="mt-auto pt-6">
									{item.code && (
										/*
											A button, not an input: copying is the only action, and a
											text field invites editing a code that must not change.
										*/
										<button
											type="button"
											data-copy-code={item.code}
											aria-label={`Copy code ${item.code}`}
											class={`flex w-full items-center justify-between gap-3 border border-dashed px-4 py-3 text-left transition-colors ${
												featured || onDark
													? 'border-current/35 hover:border-accent'
													: 'border-ink/30 bg-muted hover:border-brand'
											}`}
										>
											<span>
												<span class="mono-label block opacity-60">Use code</span>
												<span
													data-copy-label
													class="mt-0.5 block text-lg font-semibold tracking-[0.12em]"
												>
													{item.code}
												</span>
											</span>
											<span class="text-xs font-semibold opacity-70">Tap to copy</span>
										</button>
									)}
									{item.cta && (
										<div class={item.code ? 'mt-4' : ''}>
											<Button
												{...item.cta}
												style={featured ? 'accent' : item.cta.style}
												onDark={onDark || featured}
												class="w-full"
											/>
										</div>
									)}
									{(item.expires || item.terms) && (
										<p class="mt-4 text-xs leading-relaxed opacity-60">
											{item.expires && (
												<>
													Ends{' '}
													<time datetime={item.expires}>
														{dateFormat.format(new Date(item.expires))}
													</time>
													.{' '}
												</>
											)}
											{item.terms}
										</p>
									)}
								</div>
							</div>
						</div>
					</li>
				);
			})}
		</ul>
	</Section>
)}

<style>
	/*
		The punched notches: two radial-gradient holes masked out of the ticket's
		left and right edges, level with the tear line. The stub height is fixed
		(--stub) so the notches always line up with the dashed rule. The shadow
		lives on the parent because a masked element cannot cast one itself.
	*/
	.coupon {
		--stub: 9rem;
		--notch: 13px;
		-webkit-mask:
			radial-gradient(circle var(--notch) at 0 var(--stub), transparent 98%, #000) left / 51% 100%
				no-repeat,
			radial-gradient(circle var(--notch) at 100% var(--stub), transparent 98%, #000) right / 51%
				100% no-repeat;
		mask:
			radial-gradient(circle var(--notch) at 0 var(--stub), transparent 98%, #000) left / 51% 100%
				no-repeat,
			radial-gradient(circle var(--notch) at 100% var(--stub), transparent 98%, #000) right / 51%
				100% no-repeat;
	}
	.coupon-shadow {
		filter: drop-shadow(0 18px 28px rgb(15 27 51 / 0.12));
		transition: transform 0.25s ease;
	}
	.coupon-shadow:hover {
		transform: translateY(-3px);
	}
</style>

<script>
	// Copy to clipboard, with the label confirming it. Falls back silently to
	// the code simply staying selectable if the API is unavailable.
	document.querySelectorAll('[data-copy-code]').forEach((button) => {
		if (!(button instanceof HTMLElement)) return;
		const code = button.dataset.copyCode ?? '';
		const label = button.querySelector('[data-copy-label]');

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code);
				if (label) {
					label.textContent = 'Copied';
					window.setTimeout(() => {
						label.textContent = code;
					}, 1600);
				}
			} catch {
				/* Clipboard blocked; the code is still on screen to read. */
			}
		});
	});
</script>
