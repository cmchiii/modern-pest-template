---
import type { Team } from './Team.schema';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { childLevel } from '../../lib/section-base';
import SectionHead from '../ui/SectionHead.astro';

type Props = Team;

const {
	headingLevel = 'h2',
	eyebrow,
	heading,
	intro,
	members = [],
	cta,
	anchor,
	surface = 'light',
	spacing = 'md',
	width = 'wide',
} = Astro.props;

const onDark = surface === 'dark' || surface === 'brand';
---

<Section anchor={anchor} surface={surface} spacing={spacing} width={width}>
	<SectionHead
		eyebrow={eyebrow}
		heading={heading}
		intro={intro}
		level={headingLevel}
		onDark={onDark}
	/>

	{/*
		Profile cards: the first person (usually the owner) leads on a wide card,
		everyone else sits two-up with the photo beside the bio -- a directory,
		not a wall of headshots.
	*/}
	<ul class="grid gap-5 md:grid-cols-2">
		{members.map((member, i) => {
			const lead = i === 0 && members.length > 2;
			return (
				<li
					class={`grid gap-6 border p-5 sm:p-6 ${onDark ? 'border-current/15' : 'border-line bg-surface'} ${
						lead
							? 'md:col-span-2 sm:grid-cols-[14rem_1fr] sm:items-center'
							: 'grid-cols-[6.5rem_1fr] items-start sm:grid-cols-[8rem_1fr]'
					}`}
				>
					{member.photo ? (
						<div class="aspect-square overflow-hidden bg-muted">
							<img
								src={member.photo.src}
								alt={member.photo.alt}
								loading="lazy"
								class="h-full w-full object-cover"
							/>
						</div>
					) : (
						<div
							class="flex aspect-square items-center justify-center bg-muted text-3xl font-semibold text-brand"
							aria-hidden="true"
						>
							{member.name.trim().charAt(0)}
						</div>
					)}
					<div>
						{member.role && (
							<p class={`mono-label mb-2 ${onDark ? 'text-accent' : 'text-accent-ink'}`}>
								{member.role}
							</p>
						)}
						<Heading level={childLevel(headingLevel, Boolean(heading))} size={lead ? 'md' : 'sm'}>
							{member.name}
						</Heading>
						{member.bio && (
							<p
								class={`mt-2.5 text-sm leading-relaxed opacity-85 ${lead ? 'max-w-xl text-base' : ''}`}
							>
								{member.bio}
							</p>
						)}
					</div>
				</li>
			);
		})}
	</ul>

	{cta && (
		<div class="mt-14 flex justify-center">
			<Button {...cta} onDark={onDark} />
		</div>
	)}
</Section>
