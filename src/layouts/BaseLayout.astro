---
import '../styles/global.css';
import { site, themeVars } from '../lib/site';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import Popup from '../components/chrome/Popup.astro';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
	/** Show the floating button that re-opens the promo popup on demand. */
	popupLauncher?: boolean;
}

const { title, description, ogImage, noindex = false, popupLauncher = false } = Astro.props;

const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const theme = site.theme;

// A share card needs a description and an image or it renders as a bare link
// with a broken-image placeholder. Fall back to the tagline and the branded
// default card so every page has a complete preview, even one that sets neither.
const metaDescription = description ?? site.tagline;
const ogImageUrl = new URL(ogImage ?? '/media/og-default.png', canonical).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<title>{pageTitle}</title>
		{metaDescription && <meta name="description" content={metaDescription} />}
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		{metaDescription && <meta property="og:description" content={metaDescription} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{site.tagline && <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		{metaDescription && <meta name="twitter:description" content={metaDescription} />}
		<meta name="twitter:image" content={ogImageUrl} />

		{theme.fontHref && (
			<>
				<link rel="preconnect" href="https://fonts.googleapis.com" />
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link rel="stylesheet" href={theme.fontHref} />
			</>
		)}

		{/* Per-client palette. Inline so it lands before first paint. */}
		<style is:inline set:html={`:root{${themeVars(theme)}}`}></style>

		{/*
			Marks the document as scripted before first paint. Scroll-reveal styles
			hang off `.js`, so content stays visible if scripts never run.
		*/}
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>

	<body class="flex min-h-screen flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-(--radius-brand) focus:bg-brand focus:px-4 focus:py-2 focus:text-brand-fg"
		>
			Skip to main content
		</a>

		<Header />

		<main id="main" class="flex-1">
			<slot />
		</main>

		<Footer />

		<Popup showLauncher={popupLauncher} />

		<script>
			// Scroll reveal.
			//
			// Sections above the fold resolve immediately so the first paint is
			// never blank. Reduced-motion users, and browsers without
			// IntersectionObserver, get everything visible with no observer at all.
			const targets = Array.from(document.querySelectorAll('.reveal'));
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (reduced || !('IntersectionObserver' in window)) {
				targets.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
				);

				targets.forEach((el) => {
					if (el.getBoundingClientRect().top < window.innerHeight) {
						el.classList.add('is-visible');
					} else {
						observer.observe(el);
					}
				});
			}
		</script>
	</body>
</html>
