{
  "name": "clearline-pest-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "node scripts/sync-permalinks.mjs && node scripts/check-sections.mjs && astro check && astro build && node scripts/check-pages.mjs && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:sections": "node scripts/check-sections.mjs",
    "check:types": "astro check",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "sync:permalinks": "node scripts/sync-permalinks.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "marked": "^18.0.13",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
